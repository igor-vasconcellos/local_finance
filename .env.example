# =============================================================================
#  BeaconFinance — variáveis de ambiente
# -----------------------------------------------------------------------------
#  NA VERCEL: cadastre estas variáveis em Project → Settings → Environment
#  Variables (Production = site oficial; Preview = homologação).
#  NO SEU PC (desenvolvimento): `npm run setup` cria o .env a partir deste
#  arquivo e gera o SESSION_SECRET. O .env NUNCA vai para o Git.
# =============================================================================

# ---------------------------------------------------------------- Aplicação --
APP_URL=http://localhost:3000

# ------------------------------------------------------------------- Banco --
# Supabase → botão "Connect" do projeto → copie as duas URLs e troque
# [YOUR-PASSWORD] pela senha do banco.
#
# DATABASE_URL: "Transaction pooler" (porta 6543). Usada pelo app.
DATABASE_URL=
# DIRECT_URL: "Session pooler" (porta 5432). Usada só pelas migrações.
DIRECT_URL=
# Conexões por instância (na Vercel, poucas bastam).
DATABASE_POOL_MAX=3

# ------------------------------------------------------------------- Sessão --
# Chave secreta para assinar os cookies de sessão (mín. 32 caracteres).
# Gere uma com:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Trocá-la desloga todo mundo.
SESSION_SECRET=

# Duração da sessão em horas (1 a 720).
SESSION_TTL_HOURS=12

# true = cookie só trafega por HTTPS. Na Vercel: true. Em http://localhost: false.
COOKIE_SECURE=false

# ---------------------------------------------------------------------- 2FA --
TWO_FACTOR_TTL_MINUTES=5
TWO_FACTOR_MAX_ATTEMPTS=5

# ------------------------------------------------------------------- E-mail --
# MAIL_MODE:
#   smtp    → exige SMTP configurado. OBRIGATÓRIO em produção.
#   auto    → usa SMTP se SMTP_HOST estiver preenchido; senão imprime o código
#             no terminal/log (só para desenvolvimento).
#   console → nunca envia e-mail; sempre imprime o código (desenvolvimento).
MAIL_MODE=auto

# Exemplo com Gmail:
#   1. Conta Google → Segurança → ative a Verificação em duas etapas
#   2. Busque "Senhas de app" e crie uma (ex.: "beaconfinance")
#   3. Preencha (SMTP_FROM com o MESMO e-mail de SMTP_USER):
#        SMTP_HOST=smtp.gmail.com
#        SMTP_PORT=587
#        SMTP_SECURE=false            (true apenas para a porta 465)
#        SMTP_USER=seu.email@gmail.com
#        SMTP_PASS=abcd efgh ijkl mnop   (a senha de app, não a senha da conta)
#        SMTP_FROM="BeaconFinance <seu.email@gmail.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ----------------------------------------------------------- Administração --
# E-mails das contas administradoras (separados por vírgula). A conta só vira
# admin depois de confirmar o e-mail. Admin: painel /admin, nunca é bloqueado,
# cobrado ou afetado pelas funções travadas.
ADMIN_EMAILS=

# ---------------------------------------------------------------- Cadastro --
# Confere se o domínio do e-mail recebe mensagens (registro MX) antes de
# enviar o código de confirmação.
EMAIL_MX_CHECK=true

# --------------------------------------------------------- Tarefa diária ----
# A Vercel chama /api/cron/keepalive 1x por dia com este segredo (mantém o
# Supabase gratuito ativo e faz a faxina). Gere como o SESSION_SECRET.
CRON_SECRET=

# ------------------------------------------- Assinatura (Mercado Pago) ------
# Desligado (false): ninguém vê cobrança. Ligue só depois de configurar as chaves.
BILLING_ENABLED=false
# Dia em que a cobrança foi ligada (YYYY-MM-DD). Contas criadas antes ganham os
# dias de teste a partir desta data.
BILLING_START_DATE=
# Mensalidade em centavos (3900 = R$ 39,00), dias de teste e de tolerância
# depois de uma cobrança que falhou.
BILLING_PRICE_CENTS=3900
BILLING_TRIAL_DAYS=7
BILLING_GRACE_DAYS=3
# Mercado Pago → Suas integrações → sua aplicação:
#  - Credenciais de teste (TEST-…) na homologação; de produção (APP_USR-…) na produção.
#  - Webhooks → "Assinatura secreta". URL: <APP_URL>/api/webhooks/mercadopago
#    eventos: "Planos e assinaturas" e "Pagamentos".
# Nunca cole estes valores em chats ou commits; na Vercel marque como "Sensitive".
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# Só para testes locais com servidor falso. Não mude em produção.
# MP_API_BASE=https://api.mercadopago.com
