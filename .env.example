# =============================================================================
#  Local Finance — variáveis de ambiente
# -----------------------------------------------------------------------------
#  Copie para .env com:   npm run setup     (gera o SESSION_SECRET sozinho)
#  O .env NUNCA deve ir para o Git (já está no .gitignore).
# =============================================================================

# ---------------------------------------------------------------- Aplicação --
# URL pela qual você acessa o app. Se usar Tailscale/Cloudflare Tunnel,
# coloque aqui a URL HTTPS correspondente (ex.: https://meu-pc.tailnet.ts.net).
APP_URL=http://localhost:3000

# Caminho do arquivo do banco SQLite (relativo à raiz do projeto).
# Para backup, basta copiar este arquivo (ou rodar `npm run db:backup`).
DATABASE_PATH=./data/financeiro.db

# ------------------------------------------------------------------- Sessão --
# Chave secreta para assinar os cookies de sessão (mín. 32 caracteres).
# Gerada automaticamente por `npm run setup`. Trocá-la desloga todas as sessões.
SESSION_SECRET=

# Duração da sessão em horas (1 a 720).
SESSION_TTL_HOURS=12

# true = cookie só trafega por HTTPS. Deixe false em http://localhost;
# mude para true ao acessar remotamente via HTTPS (Tailscale Serve / Cloudflare).
COOKIE_SECURE=false

# ---------------------------------------------------------------------- 2FA --
# Validade do código de 6 dígitos (minutos) e tentativas antes de invalidá-lo.
TWO_FACTOR_TTL_MINUTES=5
TWO_FACTOR_MAX_ATTEMPTS=5

# ------------------------------------------------------------------- E-mail --
# MAIL_MODE:
#   auto    → usa SMTP se SMTP_HOST estiver preenchido; senão imprime o código
#             2FA no terminal (modo dev/fallback). ← recomendado
#   smtp    → exige SMTP configurado (falha ao iniciar se faltar).
#   console → nunca envia e-mail; sempre imprime o código no terminal.
MAIL_MODE=auto

# Exemplo com Gmail: crie uma "Senha de app" em
# Conta Google → Segurança → Verificação em duas etapas → Senhas de app.
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false        (true apenas para a porta 465)
#   SMTP_USER=seu.email@gmail.com
#   SMTP_PASS=xxxx xxxx xxxx xxxx
#   SMTP_FROM="Local Finance <seu.email@gmail.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
