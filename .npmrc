# Não executa scripts de instalação de dependências.
# - better-sqlite3 já traz binários prontos (Windows/macOS/Linux): sem isto, o npm
#   tentaria recompilá-lo em C++ e falharia em máquinas sem compilador.
# - Bônus de segurança: pacotes não rodam código arbitrário durante o `npm install`.
ignore-scripts=true
